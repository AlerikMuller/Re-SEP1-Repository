<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="view.CustomerViewController.CustomerViewController">
    <padding>
        <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
    </padding>

    <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Customers" />

    <!-- List of all customers -->
    <TableView fx:id="customerTable" prefHeight="220.0">
        <columns>
            <TableColumn fx:id="nameColumn" prefWidth="200.0" text="Name" />
            <TableColumn fx:id="phoneColumn" prefWidth="150.0" text="Phone" />
        </columns>
    </TableView>

    <!-- Input fields for add / edit -->
    <HBox spacing="8.0">
        <children>
            <Label minWidth="50.0" text="Name:" />
            <TextField fx:id="nameField" promptText="Full name" HBox.hgrow="ALWAYS" />
        </children>
    </HBox>
    <HBox spacing="8.0">
        <children>
            <Label minWidth="50.0" text="Phone:" />
            <TextField fx:id="phoneField" promptText="Digits only" HBox.hgrow="ALWAYS" />
        </children>
    </HBox>

    <!-- Action buttons -->
    <HBox spacing="8.0">
        <children>
            <Button fx:id="addButton" onAction="#addCustomer" text="Add" />
            <Button fx:id="editButton" onAction="#editCustomer" text="Edit" />
            <Button fx:id="removeButton" onAction="#removeCustomer" text="Remove" />
            <Button fx:id="clearButton" onAction="#reset" text="Clear" />
        </children>
    </HBox>

    <!-- Feedback message -->
    <Label fx:id="messageLabel" style="-fx-text-fill: #b00020;" text="" />
</VBox>
